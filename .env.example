# Safe local template. No secret is required to open the app. Searches require
# the separately running Scout Engine service (Gosom Google Maps Scraper); email delivery is disabled below.

# Required Scout Engine service for searches (the API listens on loopback by default).
GOSOM_URL=http://127.0.0.1:8080
PORT=8787

# Optional Docker Compose settings for Scout Engine (Gosom Google Maps Scraper).
# Pin the image to a tested release before a production deployment.
GMS_IMAGE=gosom/google-maps-scraper:latest

# Bind to loopback so the local UI/API is not exposed on the network.
GMS_BIND_ADDRESS=127.0.0.1
GMS_HOST_PORT=8080

# Persist the web UI's SQLite job database and each job's CSV file on the host.
GMS_DATA_DIR=./storage/gmapsdata

# Optional Contact Discovery. Keep the external search adapter off in a fresh
# installation; enable harvey only after installing its Python requirements.
CONTACT_SEARCH_PROVIDER=none
# SERPER_API_KEY=replace-with-your-own-optional-key

# Optional, explicitly authorized outbound proxy for the Playwright browser
# stage only. It is never rotated and does not bypass CAPTCHA, login, robots,
# or SSRF protections. Supported schemes: http, https, socks5.
# WEBSITE_AUDIT_PROXY_URL=socks5://proxy.example.invalid:1080
# WEBSITE_AUDIT_CHROMIUM_PATH=/absolute/path/to/chromium

# Maximum normalized CSV rows imported for each completed Scout Engine job. The API
# clamps this local safety limit from 1 to 1000; it does not alter the upstream scraper.
IMPORT_LEAD_LIMIT=250

# Optional AI draft generation. ChatGPT requires an explicit local connection
# and model selection in Settings; no paid API key is required by this template.
# Use mock for deterministic local development and tests.
OUTREACH_PROVIDER=chatgpt
# The active model is selected from the authenticated account and stored in SQLite app_settings.
OUTREACH_CONCURRENCY=2

# Optional email account connection. Leave the encryption key empty until you
# intentionally connect an account. Generate a unique key locally with
# `openssl rand -base64 32`; never publish or copy it into this template.
MAIL_CREDENTIAL_ENCRYPTION_KEY=
# Gmail OAuth Web/Desktop client credentials stay on the backend only.
# GMAIL_CLIENT_ID=replace-with-your-own-client-id
# GMAIL_CLIENT_SECRET=replace-with-your-own-client-secret
# GMAIL_REDIRECT_URI=http://127.0.0.1:8787/auth/mail/gmail/callback
# Zoho OAuth client credentials stay on the backend only. Register the exact
# callback URI in the Zoho API Console. Use the matching accounts.* region.
# ZOHO_CLIENT_ID=replace-with-your-own-client-id
# ZOHO_CLIENT_SECRET=replace-with-your-own-client-secret
# ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# ZOHO_API_DOMAIN=https://mail.zoho.com
# ZOHO_REDIRECT_URI=http://127.0.0.1:8787/auth/mail/zoho/callback
# For regional/organizational Zoho Mail tenants, e.g. smtp.zoho.eu and
# imap.zoho.eu. Leave unset for the global smtp.zoho.com / imap.zoho.com defaults.
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=587
# ZOHO_IMAP_HOST=imap.zoho.com
# ZOHO_IMAP_PORT=993

# Outbox safety gate. The backend sends only when this is explicitly true and
# sending is resumed in the app. Leave recipients empty for a fresh install.
OUTREACH_SEND_ENABLED=false
OUTREACH_TEST_RECIPIENTS=
